# Copier ce fichier en .env et remplacer les valeurs (valeurs factices ci-dessous).

# PostgreSQL (profil analytics)
POSTGRES_DB=bigdata
POSTGRES_USER=bigdata
POSTGRES_PASSWORD=change_me_postgres

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
GRAFANA_URL=http://localhost:3101
GRAFANA_DS_UID=bigdata-postgres

# Superset (profil superset)
SUPERSET_SECRET_KEY=change_me_long_random_string
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me_superset
SUPERSET_URL=http://localhost:8088

# Producteurs lancés depuis l'hôte
KAFKA_BROKER=localhost:9092
